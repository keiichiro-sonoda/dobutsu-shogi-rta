+// 実験 f1_select_catch (select): normalBoard と同じ値を, 分岐せずに作る (nextBoardInvNormalNC だけが使う).
+// 入れ替えた盤を先に作り, col_A > col_C のときだけ全ビットが立つマスクで選ぶ.
+// normalBoard そのものは逆向きの生成器も呼ぶので書き換えない
+static inline u_long normalBoardSel(u_long b) {
+    u_long col_A = (b >> 32) & 0xffff, col_B = (b >> 16) & 0xffff, col_C = b & 0xffff;
+    u_long sw = ((b >> 48) << 48) | (col_C << 32) | (col_B << 16) | col_A;
+    u_long m = -(u_long)(col_A > col_C);
+    return b ^ ((b ^ sw) & m);
+}
