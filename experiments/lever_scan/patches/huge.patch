+// ---- 2 MiB ページを頼んで確保する (実験 lever_scan の huge 腕) ------------------
+//
+// THP が [madvise] の機械では, 頼んだ領域にだけ巨大ページが付く.
+// ⚠️ memset より前に頼む. 触ったあとに頼んでも, その場では付かない.
+// 解放は free() のまま (aligned_alloc と対になっている).
+#include <sys/mman.h>
+#define HUGE_ALIGN ((size_t)1 << 21)
+
+static void *hugeAlloc(size_t bytes) {
+    size_t sz = (bytes + HUGE_ALIGN - 1) & ~(HUGE_ALIGN - 1);
+    void *p = aligned_alloc(HUGE_ALIGN, sz);
+    // 失敗しても 4 KiB ページのまま動く. 付いたかどうかは門番が AnonHugePages で見る
+    if (p) madvise(p, sz, MADV_HUGEPAGE);
+    return p;
+}
+
