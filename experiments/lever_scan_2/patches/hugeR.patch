+// 実験 lever_scan_2 の hugeR 腕: 後退解析の配列 (pred / pred_off / cnt / dtm) を, 索引と同じ
+// hugeAlloc で確保して fill で埋める. #21 まで Python の array / bytearray で確保していて,
+// 4 KiB ページのままだった. madvise のあとに memset するので, 触った時点で巨大ページが付く.
+// 解放はしない (後退解析が終わるまで使い, そのままプロセスが終わる)
+void *hugeFill(size_t bytes, int fill) {
+    void *p;
+    if (bytes == 0) bytes = 1;
+    p = hugeAlloc(bytes);
+    if (p) memset(p, fill, bytes);
+    return p;
+}
