+# 実験 perf_34: 段の境界で perf の数えを止めたり動かしたりする (perf stat / perf record の --control fifo:).
+# 段ごとに別の perf が数える (F1 は起動した perf, U_loop は -p で付けた perf). 呼び出し側が段ごとに2つの FIFO を
+# 作って開いておき, パスを PERF_CTL_<段> / PERF_ACK_<段> で渡す (番号を受け継がせると perf record が閉じる).
+# パスが無い段では何もしない (perf を付けない本は何も渡さない).
+# 書くのは "enable" / "disable" の1行で, perf の "ack" を受け取るまで待つ (数えの境界を揃えるため)
+_PERF_FDS = {
+    s: (os.open(os.environ["PERF_CTL_" + s], os.O_WRONLY), os.open(os.environ["PERF_ACK_" + s], os.O_RDONLY))
+    for s in ("F1", "U_loop") if "PERF_CTL_" + s in os.environ
+}
+
+def _perfCtl(stage: str, cmd: str) -> None:
+    fds = _PERF_FDS.get(stage)
+    if fds is None:
+        return
+    os.write(fds[0], (cmd + "\n").encode())
+    got = b""
+    while b"ack" not in got:
+        chunk = os.read(fds[1], 16)
+        if not chunk:
+            raise RuntimeError("perf の ack が来ない")
+        got += chunk
+
+# 実験 perf_34: PERF_DUMP_DIR があれば, F1 の各ラウンドの入力と U_loop の各段のフロンティアから,
+# 真ん中の連続した 4,096 局面 (足りなければ全部) を書き出す (ベンチの入力. 並びは本物のまま).
+# 書き出す本は段の秒を比べない (perf を付けた本とも付けない本とも別に回す)
+_PERF_DUMP = os.environ.get("PERF_DUMP_DIR")
+_PERF_DUMP_N = 4096
+
+def _perfDump(name: str, a, total: int) -> None:
+    k = min(_PERF_DUMP_N, len(a))
+    lo = (len(a) - k) // 2
+    with open(os.path.join(_PERF_DUMP, name + ".bin"), "wb") as f:
+        f.write(memoryview(a)[lo:lo + k].cast("B"))
+    with open(os.path.join(_PERF_DUMP, "index.tsv"), "a") as f:
+        f.write("%s\t%d\t%d\n" % (name, total, k))
+
