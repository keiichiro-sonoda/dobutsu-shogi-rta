+// 戻せる元のマスの表を作る. 今までの unmovePiece の判定 (s = d - moves[i], 盤の外,
+// 端の回り込み2条件, ひよこの特別扱い) をそのまま全通り回す. 生成器にインライン展開させない
+static __attribute__((noinline, cold)) void unmoveSrcTableBuild(void) {
+    for (int k = 0; k < 16; k++)
+        for (int d = 0; d < 48; d += 4) {
+            int d16 = d % 16;
+            u_long src = 0, promo = 0;
+            if (k == CHICK2) {
+                if (d16 == 4 || d16 == 8) src |= (u_long)1 << (d + 4);
+            } else {
+                const int *moves = NULL;
+                int moves_num = 0;
+                switch (k) {
+                    case GIRAFFE2: moves = GIRAFFE_MOVE; moves_num = 4; break;
+                    case ELEPHANT2: moves = ELEPHANT_MOVE; moves_num = 4; break;
+                    case LION2: moves = LION_MOVE; moves_num = 8; break;
+                    case CHICKEN2: moves = CHICKEN2_MOVE; moves_num = 6; break;
+                    default: break;
+                }
+                for (int i = 0; i < moves_num; i++) {
+                    int s = d - moves[i];
+                    if (s < 0 || 44 < s) continue;
+                    int s16 = s % 16;
+                    if (s16 == 0 && d16 == 12) continue;
+                    if (s16 == 12 && d16 == 0) continue;
+                    src |= (u_long)1 << s;
+                }
+                if (k == CHICKEN2 && d16 == 0) promo |= (u_long)1 << (d + 4);
+            }
+            g_usrc[k][d / 4] = src;
+            g_upromo[k][d / 4] = promo;
+        }
+    for (int k = 0; k < 16; k++)
+        for (int L = 0; L < 12; L++) {
+            u_long m = 0;
+            for (int sq = 0; sq < 12; sq++)
+                if ((g_xatt[k][sq] >> L) & 1) m |= (u_long)1 << (4 * sq);
+            g_uatk[k][L] = m;
+        }
+}
